---
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0b0d11" />
    <meta name="description" content="Senden Sie eine Tischanfrage an Nove." />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}nove-mark.svg`} />
    <title>Tisch reservieren | Nove</title>
  </head>
  <body class="reservation-body">
    <main class="reservation-page">
      <a class="legal-back" href={import.meta.env.BASE_URL}>← Zurück zur Startseite</a>
      <p class="legal-kicker">NOVE · TISCHANFRAGE</p>
      <h1>Ihr Tisch bei Nove</h1>
      <p class="reservation-lead">Senden Sie uns Ihre Tischanfrage. Die Bestätigung folgt direkt von Nove.</p>

      <form class="reservation-form" id="reservation-form">
        <div class="reservation-fields">
          <label>Name
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>Datum
            <input type="date" name="date" required />
          </label>
          <label>Uhrzeit
            <select name="time" required>
              <option value="">Bitte wählen</option>
              <option>17:30</option><option>18:00</option><option>18:30</option><option>19:00</option>
              <option>19:30</option><option>20:00</option><option>20:30</option>
            </select>
          </label>
        </div>
        <button class="btn-primary" type="submit">Anfrage per E-Mail senden</button>
        <p class="reservation-note">Nach dem Klick öffnet sich eine fertig ausgefüllte E-Mail. Bitte senden Sie diese ab.</p>
        <p class="reservation-message" id="reservation-message" aria-live="polite"></p>
      </form>
    </main>

    <script>
      const form = document.getElementById("reservation-form");
      const message = document.getElementById("reservation-message");
      const dateInput = form.elements.namedItem("date");
      const now = new Date();
      const localToday = new Date(now.getTime() - now.getTimezoneOffset() * 60_000)
        .toISOString()
        .split("T")[0];
      dateInput.min = localToday;

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const values = new FormData(form);
        const body = [
          "Neue Tischanfrage für Nove",
          "",
          `Datum: ${values.get("date")}`,
          `Uhrzeit: ${values.get("time")}`,
          `Name: ${values.get("name")}`
        ].join("\n");

        message.textContent = "Ihr E-Mail-Programm wird geöffnet.";
        window.location.href = `mailto:kontakt@nove-beispiel.invalid?subject=${encodeURIComponent("Tischanfrage Nove")}&body=${encodeURIComponent(body)}`;
      });
    </script>
  </body>
</html>
