---
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="Die angeforderte Seite der Al-I­man-Markt-Beispiel-Website wurde nicht gefunden." />
    <title>Seite nicht gefunden | Al Iman Markt</title>
  </head>
  <body>
    <main class="not-found-page">
      <p class="legal-kicker">AL IMAN MARKT · BEISPIEL</p>
      <p class="not-found-number">404</p>
      <h1>Diese Seite gibt es nicht.</h1>
      <p>Vielleicht wurde die Adresse falsch eingegeben. Auf der Startseite finden Sie die Al-I­man-Markt-Beispiel-Website.</p>
      <a class="btn-primary" href={import.meta.env.BASE_URL}>Zur Startseite</a>
    </main>
  </body>
</html>
