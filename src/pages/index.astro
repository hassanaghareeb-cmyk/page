---
import "../styles/global.css";

// Präzise Trennung der Halal-Speisen (100% zertifiziert, alkoholfrei)
const menuData = {
  pizzen: [
    { id: "p1", name: "Pizza Margherita", desc: "Fruchtige San-Marzano-Tomatensauce, Fior di Latte, frischer Basilikum, extra natives Olivenöl", preis: 11.50, veggie: true, sharp: false, allergens: ["A", "G"] },
    { id: "p2", name: "Pizza Diavola Halal", desc: "San-Marzano-Tomaten, Fior di Latte, scharfe kalabrische Rindersalami (Halal), hausgemachtes Chili-Öl", preis: 15.50, veggie: false, sharp: true, allergens: ["A", "G"] },
    { id: "p3", name: "Pizza Tartufo e Bresaola", desc: "Trüffelcreme, Fior di Latte, luftgetrockneter Rinderschinken (Bresaola), Rucola, Grana Padano", preis: 19.50, veggie: false, sharp: false, allergens: ["A", "G"] }
  ],
  pasten: [
    { id: "pa1", name: "Spaghetti alla Carbonara di Manzo", desc: "Traditionelle Zubereitung mit krossem Kalbs-Bacon, Eigelb, Pecorino Romano und frisch gemahlenem schwarzen Pfeffer (ohne Weißwein)", preis: 16.90, veggie: false, sharp: false, allergens: ["A", "C", "G"] },
    { id: "pa2", name: "Tagliolini al Tartufo", desc: "Hausgemachte Eiernudeln geschwenkt in cremiger Trüffelbutter, frischer schwarzer Trüffel", preis: 21.00, veggie: true, sharp: false, allergens: ["A", "C", "G"] }
  ]
};

const dishImages = {
  p1: "https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=900&q=80",
  p2: "https://images.unsplash.com/photo-1574071318508-1cdbab80d002?auto=format&fit=crop&w=900&q=80",
  p3: "https://images.unsplash.com/photo-1594007654729-407eedc4be65?auto=format&fit=crop&w=900&q=80",
  pa1: "https://images.unsplash.com/photo-1473093295043-cdd812d0e601?auto=format&fit=crop&w=900&q=80",
  pa2: "https://images.unsplash.com/photo-1551183053-bf91a1d81141?auto=format&fit=crop&w=900&q=80"
};
---

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0b0d11" />
    <meta name="description" content="Nove verbindet moderne italienische Küche mit halal-zertifizierten Zutaten und einem besonderen Fine-Dining-Erlebnis." />
    <title>Nove - Modern Halal Fine Dining</title>
</head>
<body>
    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <div class="space-transition" aria-hidden="true">
        <div class="space-transition-stars"></div>
        <div class="space-transition-streaks"></div>
    </div>
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>

    <div class="language-modal" id="language-modal" role="dialog" aria-modal="true" aria-labelledby="language-title" hidden>
        <div class="language-panel">
            <p class="language-kicker">NOVE</p>
            <h2 id="language-title">Willkommen</h2>
            <p>Bitte wählen Sie Ihre Sprache.</p>
            <div class="language-options">
                <button type="button" class="language-option" data-language="de"><span aria-hidden="true">DE</span><strong>Deutsch</strong><small>Weiter auf Deutsch</small></button>
                <button type="button" class="language-option" data-language="en"><span aria-hidden="true">EN</span><strong>English</strong><small>Continue in English</small></button>
            </div>
        </div>
    </div>

    <!-- NAVIGATION -->
    <header class="site-header">
        <div class="nav-wrapper">
            <a href="#home" class="brand-logo">Nove<span>.</span></a>
            <nav class="main-nav" id="primary-navigation" aria-label="Hauptnavigation">
                <a href="#home" data-i18n="nav-home">Startseite</a>
                <a href="#vorteile" data-i18n="nav-benefits">Ihre Vorteile</a>
                <a href="#menu" data-i18n="nav-menu">Speisekarte</a>
                <a href="#kontakt" data-i18n="nav-contact">Kontakt & Zeiten</a>
            </nav>
            <div class="nav-actions">
                <button class="language-switcher" id="language-switcher" type="button" aria-label="Sprache ändern">DE / EN</button>
                <button class="menu-toggle" id="menu-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false" aria-label="Menü öffnen">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <main id="main-content">
    <!-- HERO-BEREICH (id="home") -->
    <section class="hero-stage" id="home">
        <div class="hero-content">
            <span class="hero-subtitle" data-i18n="hero-kicker">Kulinarische Perfektion</span>
            <h1 data-i18n="hero-title">Tradition modern interpretiert</h1>
            <p data-i18n="hero-copy">Erleben Sie eine Symbiose aus handverlesenen, rein halal-zertifizierten Zutaten und zeitloser italienischer Kochkunst.</p>
            <div class="hero-actions">
                <a href="#menu" class="btn-primary" data-i18n="hero-button">Menü entdecken</a>
                <div id="live-status" class="status-indicator" aria-live="polite">Prüfe Öffnungszeiten...</div>
            </div>
            <div class="hero-highlights" aria-label="Unsere Qualitätsversprechen">
                <span>100% Halal</span>
                <span data-i18n="hero-alcohol-free">Ohne Alkohol</span>
                <span data-i18n="hero-fresh">Frisch zubereitet</span>
            </div>
        </div>
        <div class="hero-corner" aria-hidden="true">
            <span>Fine</span>
            <strong>Dining</strong>
            <i></i>
        </div>
    </section>

    <!-- VORTEILE & NUTZEN (id="vorteile") -->
    <section class="benefits-section" id="vorteile">
        <div class="section-header">
            <h2 data-i18n="benefits-title">Ihr Vorteil bei Nove</h2>
            <p class="section-lead" data-i18n="benefits-lead">Genuss ohne Kompromisse. Wir verbinden Werte mit gehobener Gastronomie.</p>
        </div>
        
        <div class="benefits-grid">
            <div class="benefit-card">
                <div class="benefit-icon">✨</div>
                <h4 data-i18n="benefit-halal-title">100% Halal Garantie</h4>
                <p data-i18n="benefit-halal-copy">Sämtliche Fleischsorten und Zutaten stammen aus lückenlos zertifizierten Halal-Quellen für Ihr absolutes Vertrauen.</p>
            </div>
            
            <div class="benefit-card">
                <div class="benefit-icon">🌿</div>
                <h4 data-i18n="benefit-taste-title">Reiner Geschmack</h4>
                <p data-i18n="benefit-taste-copy">Unsere Küche ist komplett alkoholfrei. Saucen und Desserts werden handwerklich präzise ohne Wein oder Gelatine vollendet.</p>
            </div>
            
            <div class="benefit-card">
                <div class="benefit-icon">👑</div>
                <h4 data-i18n="benefit-ambience-title">Fine Dining Ambiente</h4>
                <p data-i18n="benefit-ambience-copy">Ein modern gestaltetes Premium-Ambiente, das den perfekten Rahmen für besondere Abende mit Familie und Freunden bietet.</p>
            </div>
        </div>
    </section>

    <section class="signature-section" aria-labelledby="signature-title">
        <div class="signature-copy">
            <p class="section-kicker" data-i18n="signature-kicker">DIE NOVE-ERFAHRUNG</p>
            <h2 id="signature-title" data-i18n="signature-title">Ein Abend, der nachklingt.</h2>
            <p data-i18n="signature-copy">Von der Auswahl der Zutaten bis zum letzten Detail auf dem Teller: Wir verbinden italienische Handwerkskunst mit einer Atmosphäre, in der man gerne länger bleibt.</p>
            <a class="text-link" href="#menu"><span data-i18n="signature-link">Unsere Speisen entdecken</span> <span aria-hidden="true">→</span></a>
        </div>
        <a class="signature-mark signature-reservation-link" href={`${import.meta.env.BASE_URL}reservierung/`} aria-label="Tisch reservieren">
            <span>Italian</span>
            <strong>N</strong>
            <span>Halal</span>
            <em class="reservation-cta">Tisch reservieren</em>
        </a>
    </section>

    <section class="occasion-section" aria-labelledby="occasion-title">
        <div>
            <p class="section-kicker" data-i18n="occasion-kicker">FÜR IHREN BESONDEREN ABEND</p>
            <h2 id="occasion-title" data-i18n="occasion-title">Mehr als ein Abendessen.</h2>
        </div>
        <div class="occasion-copy">
            <p data-i18n="occasion-copy">Ob ein ruhiges Dinner zu zweit, ein Familientreffen oder ein besonderer Anlass: Bei Nove stehen Genuss, Aufmerksamkeit und eine entspannte Atmosphäre im Mittelpunkt.</p>
            <ul class="occasion-list">
                <li data-i18n="occasion-one">Sorgfältig ausgewählte Zutaten</li>
                <li data-i18n="occasion-two">Alkoholfreie italienische Küche</li>
                <li data-i18n="occasion-three">Persönliche Tischanfrage in wenigen Schritten</li>
            </ul>
        </div>
    </section>

    <!-- SPEISEKARTE SECTION (id="menu") -->
    <section class="menu-section" id="menu">
        <div class="section-header">
            <h2 data-i18n="menu-title">Unsere Speisen</h2>
            <p class="section-lead" data-i18n="menu-lead">Präzise abgestimmte Aromen, frisch für Sie zubereitet.</p>
            
            <div class="filter-controls">
                <button class="filter-trigger active" type="button" data-target="all" aria-pressed="true" data-i18n="filter-all">Gesamtes Menü</button>
                <button class="filter-trigger" type="button" data-target="veggie" aria-pressed="false" data-i18n="filter-veggie">🌱 Vegetarisch</button>
                <button class="filter-trigger" type="button" data-target="sharp" aria-pressed="false" data-i18n="filter-sharp">🌶️ Scharf</button>
            </div>
        </div>

        <div class="menu-container">
            <div class="menu-block">
                <h3 class="category-title" data-i18n="category-pizza">Pizza dal Forno</h3>
                <div class="items-list">
                    {menuData.pizzen.map((item) => (
                        <div class="dish-card" data-veggie={item.veggie.toString()} data-sharp={item.sharp.toString()}>
                            <div class="dish-meta">
                                <h4 class="dish-name">
                                    {item.name}
                                    {item.veggie && <span class="diet-tag" data-i18n="tag-veggie">VEGGIE</span>}
                                    {item.sharp && <span class="diet-tag sharp" data-i18n="tag-sharp">SCHARF</span>}
                                </h4>
                                <span class="dish-price">{item.preis.toFixed(2)} €</span>
                            </div>
                            <p class="dish-description" data-i18n={`dish-${item.id}-desc`}>{item.desc}</p>
                            <span class="allergen-info"><span data-i18n="allergen-label">Allergene</span>: {item.allergens.join(', ')}</span>
                            <img class="dish-image" src={dishImages[item.id]} alt={`Foto von ${item.name}`} loading="lazy" />
                        </div>
                    ))}
                </div>
            </div>

            <div class="menu-block">
                <h3 class="category-title" data-i18n="category-pasta">Pasta Fresca</h3>
                <div class="items-list">
                    {menuData.pasten.map((item) => (
                        <div class="dish-card" data-veggie={item.veggie.toString()} data-sharp={item.sharp.toString()}>
                            <div class="dish-meta">
                                <h4 class="dish-name">
                                    {item.name}
                                    {item.veggie && <span class="diet-tag" data-i18n="tag-veggie">VEGGIE</span>}
                                    {item.sharp && <span class="diet-tag sharp" data-i18n="tag-sharp">SCHARF</span>}
                                </h4>
                                <span class="dish-price">{item.preis.toFixed(2)} €</span>
                            </div>
                            <p class="dish-description" data-i18n={`dish-${item.id}-desc`}>{item.desc}</p>
                            <span class="allergen-info"><span data-i18n="allergen-label">Allergene</span>: {item.allergens.join(', ')}</span>
                            <img class="dish-image" src={dishImages[item.id]} alt={`Foto von ${item.name}`} loading="lazy" />
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    </main>

    <!-- FOOTER / KONTAKT -->
    <footer class="site-footer" id="kontakt">
        <div class="footer-grid">
            <div class="footer-box">
                <h5 data-i18n="footer-location">Standort</h5>
                <address>Musterstraße 42<br>12345 Musterstadt</address>
            </div>
            <div class="footer-box">
                <h5 data-i18n="footer-promise">Unser Versprechen</h5>
                <p>100% Halal-Garantie</p>
                <p data-i18n="footer-alcohol-free">Kein Alkohol im gesamten Betrieb</p>
            </div>
            <div class="footer-box">
                <h5 data-i18n="footer-hours">Öffnungszeiten</h5>
                <p data-i18n="footer-hours-week">Di — Sa: 17:30 — 21:00 Uhr</p>
                <p data-i18n="footer-hours-rest">So & Mo: Ruhetag</p>
            </div>
            <div class="footer-box">
                <h5 data-i18n="footer-contact">Kontakt</h5>
                <p data-i18n="footer-contact-copy">Ruf uns an oder komm einfach vorbei – wir freuen uns auf dich.</p>
                <p>Telefon: <a href="tel:+4955163451185">0551 63451185</a><br>E-Mail: <a href="mailto:ghareebserag@gmail.com">ghareebserag@gmail.com</a></p>
            </div>
        </div>
        <div class="footer-credits">
            <p>&copy; 2026 Nove. Alle Rechte vorbehalten. <span class="powered-by">Powered by Cloudflare</span> | <a href={`${import.meta.env.BASE_URL}impressum/`}>Impressum</a> | <a href={`${import.meta.env.BASE_URL}datenschutz/`}>Datenschutz</a></p>
        </div>
    </footer>

    <div class="quick-actions" aria-label="Schnellzugriff">
        <a href="tel:+4955163451185" aria-label="Nove anrufen">☎</a>
    </div>

    <!-- INTERAKTIVES JAVASCRIPT -->
    <script>
        const translations = {
            en: {
                "nav-home": "Home",
                "nav-benefits": "Why Nove",
                "nav-menu": "Menu",
                "nav-contact": "Contact & hours",
                "hero-kicker": "Culinary perfection",
                "hero-title": "Tradition, interpreted for today",
                "hero-copy": "Experience a harmony of carefully selected, fully halal-certified ingredients and timeless Italian craftsmanship.",
                "hero-button": "Explore the menu",
                "hero-alcohol-free": "Alcohol-free",
                "hero-fresh": "Freshly prepared",
                "benefits-title": "The Nove difference",
                "benefits-lead": "Enjoy without compromise. We bring together values and elevated dining.",
                "benefit-halal-title": "100% halal promise",
                "benefit-halal-copy": "Every meat and ingredient comes from fully certified halal sources, so you can dine with complete confidence.",
                "benefit-taste-title": "Pure flavour",
                "benefit-taste-copy": "Our kitchen is entirely alcohol-free. Sauces and desserts are finished with precision, without wine or gelatine.",
                "benefit-ambience-title": "Fine dining ambience",
                "benefit-ambience-copy": "A modern premium setting that creates the perfect backdrop for memorable evenings with family and friends.",
                "signature-kicker": "THE NOVE EXPERIENCE",
                "signature-title": "An evening that stays with you.",
                "signature-copy": "From selecting ingredients to the final detail on the plate: we pair Italian craftsmanship with an atmosphere made for lingering.",
                "signature-link": "Discover our dishes",
                "occasion-kicker": "FOR YOUR SPECIAL EVENING",
                "occasion-title": "More than dinner.",
                "occasion-copy": "Whether it is a quiet dinner for two, a family gathering or a special occasion: at Nove, flavour, care and a relaxed atmosphere take centre stage.",
                "occasion-one": "Carefully selected ingredients",
                "occasion-two": "Alcohol-free Italian cuisine",
                "occasion-three": "A personal table request in just a few steps",
                "menu-title": "Our dishes",
                "menu-lead": "Thoughtfully balanced flavours, freshly prepared for you.",
                "filter-all": "Full menu",
                "filter-veggie": "🌱 Vegetarian",
                "filter-sharp": "🌶️ Spicy",
                "category-pizza": "Pizza dal Forno",
                "category-pasta": "Fresh pasta",
                "tag-veggie": "VEGGIE",
                "tag-sharp": "SPICY",
                "allergen-label": "Allergens",
                "dish-p1-desc": "Fruity San Marzano tomato sauce, Fior di Latte, fresh basil, extra-virgin olive oil",
                "dish-p2-desc": "San Marzano tomatoes, Fior di Latte, spicy Calabrian beef salami (halal), house-made chilli oil",
                "dish-p3-desc": "Truffle cream, Fior di Latte, air-dried beef (bresaola), rocket, Grana Padano",
                "dish-pa1-desc": "Traditional preparation with crisp veal bacon, egg yolk, Pecorino Romano and freshly ground black pepper (without white wine)",
                "dish-pa2-desc": "Homemade egg pasta tossed in creamy truffle butter, fresh black truffle",
                "footer-location": "Location",
                "footer-promise": "Our promise",
                "footer-alcohol-free": "No alcohol anywhere in our restaurant",
                "footer-hours": "Opening hours",
                "footer-hours-week": "Tue — Sat: 5:30 pm — 9:00 pm",
                "footer-hours-rest": "Sun & Mon: Closed",
                "footer-contact": "Contact",
                "footer-contact-copy": "Call us or simply stop by — we look forward to welcoming you.",
                "status-closed": "🔴 Closed",
                "status-open": "🟢 Open now",
                "status-opens-at": "🔴 Closed (opens at 5:30 pm)"
            }
        };

        let activeLanguage = "de";
        const languageModal = document.getElementById("language-modal");
        const languageButtons = document.querySelectorAll(".language-option");
        const languageSwitcher = document.getElementById("language-switcher");
        const menuToggle = document.getElementById("menu-toggle");
        const mainNavigation = document.getElementById("primary-navigation");
        const pageDescription = document.querySelector('meta[name="description"]');
        const germanTexts = {};

        document.querySelectorAll("[data-i18n]").forEach((element) => {
            germanTexts[element.dataset.i18n] = element.textContent;
        });

        const showLanguagePicker = () => {
            languageModal.hidden = false;
            document.body.classList.add("language-modal-open");
            languageButtons[0]?.focus();
        };

        const setLanguage = (language) => {
            activeLanguage = language;
            const content = language === "de" ? germanTexts : translations.en;

            document.documentElement.lang = language;
            document.querySelectorAll("[data-i18n]").forEach((element) => {
                const key = element.dataset.i18n;
                if (content[key]) element.textContent = content[key];
            });

            if (language === "en") {
                document.title = "Nove - Modern Halal Fine Dining";
                if (pageDescription) pageDescription.content = "Nove combines modern Italian cuisine, halal-certified ingredients and a distinctive fine dining experience.";
            } else {
                document.title = "Nove - Modern Halal Fine Dining";
                if (pageDescription) pageDescription.content = "Nove verbindet moderne italienische Küche mit halal-zertifizierten Zutaten und einem besonderen Fine-Dining-Erlebnis.";
            }
            checkStatus();
        };

        const chooseLanguage = (language) => {
            setLanguage(language);
            try { localStorage.setItem("nove-language", language); } catch (_) { /* Sprache gilt nur für diesen Besuch. */ }
            languageModal.hidden = true;
            document.body.classList.remove("language-modal-open");
        };

        languageButtons.forEach((button) => {
            button.addEventListener("click", () => chooseLanguage(button.dataset.language));
        });

        languageSwitcher?.addEventListener("click", showLanguagePicker);

        const closeMenu = () => {
            mainNavigation?.classList.remove("is-open");
            menuToggle?.classList.remove("is-open");
            menuToggle?.setAttribute("aria-expanded", "false");
            menuToggle?.setAttribute("aria-label", "Menü öffnen");
        };

        menuToggle?.addEventListener("click", () => {
            const isOpen = mainNavigation?.classList.toggle("is-open");
            menuToggle.classList.toggle("is-open", isOpen);
            menuToggle.setAttribute("aria-expanded", String(isOpen));
            menuToggle.setAttribute("aria-label", isOpen ? "Menü schließen" : "Menü öffnen");
        });

        mainNavigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
        document.addEventListener("keydown", (event) => { if (event.key === "Escape") closeMenu(); });

        const checkStatus = () => {
            const now = new Date();
            const day = now.getDay();
            const hour = now.getHours();
            const minute = now.getMinutes();
            const currentTime = hour * 60 + minute;

            const openTime = 17 * 60 + 30; 
            const closeTime = 21 * 60;

            const statusEl = document.getElementById("live-status");
            if (!statusEl) return;
            
            const copy = translations[activeLanguage] || {};
            if (day === 0 || day === 1) {
                statusEl.textContent = copy["status-closed"] || "🔴 Geschlossen (Ruhetag)";
            } else if (currentTime >= openTime && currentTime < closeTime) {
                statusEl.textContent = copy["status-open"] || "🟢 Jetzt geöffnet";
            } else {
                statusEl.textContent = copy["status-opens-at"] || "🔴 Geschlossen (Öffnet um 17:30)";
            }
        };

        try {
            const savedLanguage = localStorage.getItem("nove-language");
            if (savedLanguage === "de" || savedLanguage === "en") {
                setLanguage(savedLanguage);
            } else {
                showLanguagePicker();
            }
        } catch (_) {
            showLanguagePicker();
        }

        const filterButtons = document.querySelectorAll(".filter-trigger");
        const dishCards = document.querySelectorAll(".dish-card");
        const progressBar = document.querySelector(".scroll-progress span");
        const navLinks = document.querySelectorAll(".main-nav a");

        filterButtons.forEach(button => {
            button.addEventListener("click", () => {
                filterButtons.forEach(btn => btn.classList.remove("active"));
                filterButtons.forEach(btn => btn.setAttribute("aria-pressed", "false"));
                button.classList.add("active");
                button.setAttribute("aria-pressed", "true");

                const target = button.getAttribute("data-target");

                dishCards.forEach(card => {
                    const isVeggie = card.getAttribute("data-veggie") === "true";
                    const isSharp = card.getAttribute("data-sharp") === "true";

                    if (target === "all") {
                        card.style.display = "block";
                    } else if (target === "veggie" && isVeggie) {
                        card.style.display = "block";
                    } else if (target === "sharp" && isSharp) {
                        card.style.display = "block";
                    } else {
                        card.style.display = "none";
                    }
                });
            });
        });

        window.addEventListener("scroll", () => {
            const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
            const progress = scrollableHeight > 0 ? (window.scrollY / scrollableHeight) * 100 : 0;
            progressBar.style.width = `${progress}%`;
        }, { passive: true });

        const navObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                navLinks.forEach((link) => {
                    const isActive = link.getAttribute("href") === `#${entry.target.id}`;
                    link.classList.toggle("is-active", isActive);
                    if (isActive) link.setAttribute("aria-current", "page");
                    else link.removeAttribute("aria-current");
                });
            });
        }, { rootMargin: "-35% 0px -55% 0px", threshold: 0 });

        document.querySelectorAll("#home, #vorteile, #menu, #kontakt").forEach((section) => navObserver.observe(section));

        const reservationLink = document.querySelector(".signature-reservation-link");
        reservationLink?.addEventListener("click", (event) => {
            if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
            event.preventDefault();
            document.body.classList.add("is-reserving");
            window.setTimeout(() => { window.location.href = reservationLink.href; }, 1900);
        });

        const revealElements = document.querySelectorAll(
            ".section-header, .benefit-card, .signature-copy, .signature-mark, .occasion-section, .menu-block, .footer-box"
        );

        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            revealElements.forEach((element, index) => {
                element.classList.add("scroll-reveal");
                element.style.setProperty("--reveal-delay", `${(index % 3) * 90}ms`);
            });

            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-visible");
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.16 });

            revealElements.forEach((element) => observer.observe(element));
        }

        document.addEventListener("astro:page-load", () => {
            checkStatus();
        });

        checkStatus();
        setInterval(checkStatus, 60000);
    </script>
</body>
</html>
