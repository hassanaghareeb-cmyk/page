---
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#174738" />
    <meta name="description" content="Beispiel-Website für Al Iman Markt Göttingen – moderne Darstellung eines internationalen Lebensmittelmarkts." />
    <title>Al Iman Markt Göttingen – Beispiel-Website</title>
  </head>
  <body class="market-body">
    <div class="market-scroll-progress" aria-hidden="true"><span></span></div>
    <div class="market-demo-ribbon">Beispiel-Website · Nicht offiziell · Alle Angaben sind Musterangaben</div>

    <header class="market-header">
      <a class="market-logo" href="#start" aria-label="Al Iman Markt – Startseite">
        <span aria-hidden="true">AM</span>
        <strong>Al Iman <em>Markt</em></strong>
      </a>
      <nav class="market-nav" aria-label="Seitennavigation">
        <a href="#sortiment">Sortiment</a>
        <a href="#werte">Unser Markt</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
    </header>

    <main>
      <section class="market-hero" id="start">
        <div class="market-hero-copy">
          <p class="market-kicker">INTERNATIONALE LEBENSMITTEL · GÖTTINGEN</p>
          <h1>Gute Zutaten.<br /><i>Jeden Tag.</i></h1>
          <p>Eine moderne Beispiel-Website für einen vielfältigen Lebensmittelmarkt: frisch, international und nah an der Nachbarschaft.</p>
          <div class="market-actions">
            <a class="market-button" href="#sortiment">Sortiment entdecken <span aria-hidden="true">↓</span></a>
            <span class="market-example-tag">Nur ein Design-Beispiel</span>
          </div>
        </div>
        <div class="market-hero-art" aria-hidden="true">
          <div class="market-orbit market-orbit-one"></div>
          <div class="market-orbit market-orbit-two"></div>
          <div class="market-fruit market-lemon">✦</div>
          <div class="market-fruit market-leaf">❋</div>
          <div class="market-basket"><span>Al Iman</span><strong>MARKT</strong><i>Göttingen</i></div>
        </div>
      </section>

      <section class="market-section market-range" id="sortiment" aria-labelledby="range-title">
        <div class="market-section-heading market-reveal">
          <p class="market-kicker">MUSTER-SORTIMENT</p>
          <h2 id="range-title">Alles für Ihre Küche.</h2>
          <p>Die Kategorien sind Beispiele und können später einfach durch das echte Sortiment ersetzt werden.</p>
        </div>
        <div class="market-category-grid">
          <article class="market-category-card market-card-green market-reveal">
            <span class="market-card-number">01</span>
            <span class="market-card-icon" aria-hidden="true">🥬</span>
            <h3>Frische & Gemüse</h3>
            <p>Obst, Gemüse, Kräuter und Zutaten für den täglichen Einkauf.</p>
          </article>
          <article class="market-category-card market-card-cream market-reveal">
            <span class="market-card-number">02</span>
            <span class="market-card-icon" aria-hidden="true">🫙</span>
            <h3>Internationale Spezialitäten</h3>
            <p>Gewürze, Reis, Hülsenfrüchte, Konserven und ausgewählte Produkte.</p>
          </article>
          <article class="market-category-card market-card-gold market-reveal">
            <span class="market-card-number">03</span>
            <span class="market-card-icon" aria-hidden="true">🥖</span>
            <h3>Für den Alltag</h3>
            <p>Grundnahrungsmittel, Getränke und alles für einen gut gefüllten Vorrat.</p>
          </article>
        </div>
      </section>

      <section class="market-values market-reveal" id="werte" aria-labelledby="values-title">
        <div>
          <p class="market-kicker">MEHR ALS EINKAUFEN</p>
          <h2 id="values-title">Ein Markt für die Nachbarschaft.</h2>
        </div>
        <div class="market-value-list">
          <p><span>01</span> Freundlich, übersichtlich und nah.</p>
          <p><span>02</span> Internationale Vielfalt an einem Ort.</p>
          <p><span>03</span> Beispielhafte Öffnungszeiten und Kontaktdaten klar gekennzeichnet.</p>
        </div>
      </section>

      <section class="market-contact" id="kontakt" aria-labelledby="contact-title">
        <div class="market-reveal">
          <p class="market-kicker">BESUCHEN SIE UNS</p>
          <h2 id="contact-title">Al Iman Markt<br />Göttingen</h2>
          <p>Diese Kontaktdaten sind nur Beispiele und gehören zu keiner echten Person oder Adresse.</p>
        </div>
        <div class="market-contact-card market-reveal">
          <p><strong>Beispiel-Adresse</strong><br />Marktstraße 12<br />37000 Göttingen</p>
          <p><strong>Beispiel-Öffnungszeiten</strong><br />Mo – Sa · 09:00 – 20:00 Uhr<br />So · geschlossen</p>
          <p><strong>Beispiel-Kontakt</strong><br />+49 0000 000000<br />kontakt@al-iman-beispiel.invalid</p>
        </div>
      </section>
    </main>

    <footer class="market-footer">
      <p><strong>Al Iman Markt Göttingen</strong> · Beispiel-Website · Nicht offiziell</p>
      <a href="#start">Zurück nach oben</a>
    </footer>

    <script>
      const progress = document.querySelector(".market-scroll-progress span");
      const updateProgress = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progress.style.width = `${max > 0 ? (window.scrollY / max) * 100 : 0}%`;
      };
      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();

      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const elements = document.querySelectorAll(".market-reveal");
        elements.forEach((element, index) => element.style.setProperty("--market-delay", `${(index % 3) * 110}ms`));
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.14 });
        elements.forEach((element) => observer.observe(element));
      }
    </script>
  </body>
</html>
